<div class="modal fade" id="<%= id %>" tabindex="-1" aria-labelledby="<%= id %>-label" aria-hidden="true">
  <div class="modal-dialog">
    <form class="modal-content" method="post" action="<%= action %>">
      <input type="hidden" name="id">
      <div class="modal-header">
        <h2 class="modal-title fs-5" id="<%= id %>-label"><%= heading %></h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3">
          <label class="form-label" for="<%= id %>-title">Recipe Name</label>
          <input type="text" class="form-control" id="<%= id %>-title" name="title" maxlength="200" required>
        </div>
        <div class="mb-3">
          <label class="form-label" for="<%= id %>-ingredients">Ingredients</label>
          <textarea class="form-control" id="<%= id %>-ingredients" name="ingredients" rows="4" required></textarea>
        </div>
        <div class="mb-3">
          <label class="form-label" for="<%= id %>-directions">Directions</label>
          <textarea class="form-control" id="<%= id %>-directions" name="directions" rows="4" required></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        <button type="submit" class="btn btn-primary">Save</button>
      </div>
    </form>
  </div>
</div>
